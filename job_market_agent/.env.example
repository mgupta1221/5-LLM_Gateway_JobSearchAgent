# ════════════════════════════════════════════════════════
#  job_market_agent — job market API keys only
#  LLM provider keys live in llm_gatewayV2/.env
# ════════════════════════════════════════════════════════

# ─── Adzuna India (job listings) ─────────────────────────
# Sign up free: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ─── Tavily (salary extraction) ──────────────────────────
# Sign up free: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# ─── Gateway URL ─────────────────────────────────────────
LLM_GATEWAY_V2_URL=http://localhost:8100
