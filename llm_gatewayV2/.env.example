# ════════════════════════════════════════════════════════
#  llm_gatewayV2 — LLM provider keys and gateway settings
#  Copy this file to .env and fill in your API keys
# ════════════════════════════════════════════════════════

# ─── Failover order ──────────────────────────────────────
LLM_ORDER=anthropic,cerebras,gemini,openrouter,groq

# ─── Provider API keys ───────────────────────────────────
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPEN_ROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# ─── Model overrides ─────────────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5-TalkToData
ANTHROPIC_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama-3.3-70b
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── Ollama (local, optional) ────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# ─── Gateway port ────────────────────────────────────────
GATEWAY_V2_PORT=8100

# ─── Per-provider timeout (seconds) ──────────────────────
PROVIDER_TIMEOUT=35
